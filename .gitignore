# ===== CRÍTICO: credenciais e dados =====
# Nunca suba estes arquivos. O .env tem a string de conexão do Neon
# (usuário e senha do banco). Uma vez no histórico do Git, fica lá
# para sempre, mesmo que você apague o arquivo depois.
.env
.env.*
!.env.example

# Bancos locais
*.db
*.sqlite
*.sqlite3

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Ambientes virtuais
venv/
env/
ENV/
.venv/

# Distribuição / build
build/
dist/
*.egg-info/
.eggs/

# Testes e cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/

# ===== Logs =====
*.log
uvicorn.log

# ===== Editor / IDE =====
.vscode/
.idea/
*.swp
*.swo

# ===== Sistema operacional =====
Thumbs.db
desktop.ini
.DS_Store

# ===== Ferramentas =====
.claude/

# ===== Frontend (se usar Node) =====
node_modules/
.next/
dist/