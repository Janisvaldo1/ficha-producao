# Exemplo de arquivo de configuração para teste local
# Copie para .env e ajuste conforme necessário

# ======== MODO 1: SQLite (padrão, desenvolvimento) ========
# Não defina DATABASE_URL — o app usará ficha.db automaticamente
# Descomente a linha abaixo para desabilitar (ou deixe comentada)
# DATABASE_URL=

# ======== MODO 2: Postgres (produção/teste) ========
# Descomente uma das opções abaixo e ajuste a connection string

# Opção A: Neon (recomendado para teste rápido)
# 1. Vá pra https://console.neon.tech
# 2. Crie um projeto (free tier)
# 3. Copie a connection string e descomente abaixo:
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname

# Opção B: Docker PostgreSQL local
# Rode antes: docker run -d --name postgres-test -e POSTGRES_DB=ficha -e POSTGRES_PASSWORD=test123 -p 5432:5432 postgres:15
# DATABASE_URL=postgresql://postgres:test123@localhost:5432/ficha

# Opção C: PostgreSQL instalado no seu PC
# Rode antes: createdb ficha
# DATABASE_URL=postgresql://user@localhost/ficha

# ======== Testes recomendados ========
#
# 1. Com SQLite (padrão):
#    $ cd backend
#    $ uvicorn app.main:app --reload
#    → Deve conectar em ficha.db e funcionar normalmente
#
# 2. Com Postgres (teste):
#    $ export DATABASE_URL="postgresql://user:pass@host/ficha"  (ou .env)
#    $ cd backend
#    $ uvicorn app.main:app --reload
#    → Deve conectar no Postgres e funcionar identicamente
#
# 3. Verificar que os dados estão no banco certo:
#    $ sqlite3 backend/ficha.db "SELECT COUNT(*) FROM recibos;"   # SQLite
#    $ psql $DATABASE_URL -c "SELECT COUNT(*) FROM recibos;"      # Postgres
